<Application x:Class="DivaModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DivaModManager">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <FontFamily x:Key="DmmeFont">Noto Sans CJK JP Black</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary Source="/Common/Style/Button.xaml"/>
                <ResourceDictionary Source="/Common/Style/ComboBox.xaml"/>
                <ResourceDictionary Source="/Common/Style/ScrollViewer.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

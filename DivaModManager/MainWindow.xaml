                        <RowDefinition Height="50"/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="214.781"/>
                        <ColumnDefinition Width="105.219"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Name="DMAControlPanelLeft" Grid.ColumnSpan="4" Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <ComboBox Margin="5,0,5,0" Grid.Column="0" IsEnabled="False" FontFamily="{StaticResource DmmFont}" FontWeight="Normal" FontSize="18" Name="DMASortBox" Height="35" MinWidth="150" SelectionChanged="DMAFilterSelectionChanged" HorizontalAlignment="Left" Width="150">
                            <ComboBoxItem IsSelected="True">Latest</ComboBoxItem>
                            <ComboBoxItem>Downloads</ComboBoxItem>
                            <ComboBoxItem>Likes</ComboBoxItem>
                        </ComboBox>
                        <ComboBox Margin="5,0,5,0" Grid.Column="1" IsEnabled="False" Grid.Row="1" FontFamily="{StaticResource DmmFont}" FontSize="18" Name="DMAFilterBox" Height="35" HorizontalAlignment="Left" MinWidth="150" SelectionChanged="DMAFilterSelectionChanged">
                            <ComboBoxItem IsSelected="True">All</ComboBoxItem>
                            <ComboBoxItem>Song</ComboBoxItem>
                            <ComboBoxItem>Cover</ComboBoxItem>
                            <ComboBoxItem>Module</ComboBoxItem>
                            <ComboBoxItem>UI</ComboBoxItem>
                            <ComboBoxItem>Plugin</ComboBoxItem>
                            <ComboBoxItem>Other</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <TextBox Margin="10,8,10,8" Padding="5,5,5,5" Grid.Column="2" FontFamily="{StaticResource DmmFont}" IsEnabled="False" KeyDown="DMASearchBar_KeyDown" Name="DMASearchBar" MinWidth="200" VerticalContentAlignment="Center"/>
                    <TextBlock Margin="15,0,0,0" Padding="5,5,5,5" Grid.Column="2" FontFamily="{StaticResource DmmFont}" IsHitTestVisible="False" MinWidth="200" Text="Search..." VerticalAlignment="Center" Foreground="#303030">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=DMASearchBar, Path=Text.IsEmpty}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Name="DMAControlPanelRight" Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Center">
                        <Button Grid.Column="0" IsEnabled="False" HorizontalAlignment="Right" Click="DMASearchButton_Click" Name="DMASearchButton" Height="35" Width="35" Margin="5,0,5,0">
                            <Image Source="/Assets/fontawesome/search.png" Height="28" Width="28" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                            <CheckBox Name="NSFWCheckboxDMA" IsEnabled="False" Unchecked="NSFWCheckboxDMA_Checked" Checked="NSFWCheckboxDMA_Checked" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock Foreground="#f2f2f2" FontFamily="{StaticResource DmmFont}" VerticalAlignment="Center" FontSize="18" Visibility="Collapsed">NS<LineBreak/>FW</TextBlock>
                        </StackPanel>
                        <Image Margin="0,0,6,0" Name="DmaButton" VerticalAlignment="Center" HorizontalAlignment="Left" Width="35" Height="35" Source="/Assets/DMA_BLACK.png" Cursor="Hand" MouseLeftButtonDown="DmaButton_Click"/>
                        <Popup PlacementTarget="{Binding ElementName=DmaButton}" IsOpen="{Binding IsMouseDirectlyOver, ElementName=DmaButton, Mode=OneWay}" AllowsTransparency="True">
                            <Border CornerRadius="5" Panel.ZIndex="0" Margin="10">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#101010" Opacity="0.9"/>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <SolidColorBrush Color="#101010" Opacity="0.9"/>
                                </Border.Background>
                                <TextBlock Margin="10" FontFamily="{StaticResource DmmFont}" Text="Go to divamodarchive.com" Foreground="#f2f2f2" FontWeight="Normal" FontSize="18" VerticalAlignment="Center" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <DockPanel x:Name="DMAControlPanelBottomLeft" Grid.Row="2" VerticalAlignment="Center"  HorizontalAlignment="Left" Grid.ColumnSpan="3">
                        <CheckBox Name="DMACacheUseCheckBox" IsEnabled="True" Checked="DMACacheUseCheckBox_Checked" Unchecked="DMACacheUseCheckBox_Unchecked" Margin="10" VerticalAlignment="Center" Content="Cache Use" FontFamily="{StaticResource DmmFont}" Foreground="#f2f2f2" IsChecked="True"/>
                        <Button Click="DMAClearCacheButton_Click" Name="DMAClearCacheButton" Content="Clear Cache" FontFamily="{StaticResource DmmFont}" FontSize="18"  Height="35" Width="120" Background="#181818" BorderBrush="#252525" IsEnabled="False" Foreground="#f2f2f2" Margin="5" >
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>

                    <StackPanel x:Name="DMAControlPanelBottomCenter" Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="4" VerticalAlignment="Center">
                        <Button IsEnabled="False" FontFamily="{StaticResource DmmFont}" Name="DMAPageLeft" Click="DMADecrementPage" Content="&lt;" HorizontalAlignment="Right" Margin="10,0,10,0" FontSize="18" Height="35" Width="35" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"/>
                        <TextBlock Name="DMAPage" Text="Page 1" Foreground="#f2f2f2" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource DmmFont}" FontSize="18" />
                        <Button Grid.Column="3" IsEnabled="False" FontFamily="{StaticResource DmmFont}" Name="DMAPageRight" Click="DMAIncrementPage" Content=">" HorizontalAlignment="Left" Margin="10,0,10,0" FontSize="18" Height="35" Width="35" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2"/>
                        <ComboBox IsEnabled="False" Margin="10,0,10,0" FontFamily="{StaticResource DmmFont}" Name="DMAPageBox" SelectionChanged="DMAPageBox_SelectionChanged" Height="35" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="DMAControlPanelBottomRight" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Grid.ColumnSpan="4" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,15,0" FontFamily="{StaticResource DmmFont}" Foreground="#f2f2f2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Normal">
                            Per Page:
                        </TextBlock>
                        <ComboBox IsEnabled="False" FontFamily="{StaticResource DmmFont}" Name="DMAPerPageBox" SelectionChanged="DMAPerPageSelectionChanged" Height="35" VerticalAlignment="Center">
                            <ComboBoxItem>10</ComboBoxItem>
                            <ComboBoxItem IsSelected="True">20</ComboBoxItem>
                            <ComboBoxItem>30</ComboBoxItem>
                            <ComboBoxItem>40</ComboBoxItem>
                            <ComboBoxItem>50</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.RowSpan="3" Grid.ColumnSpan="4" Name="DMAMediaPanel" Panel.ZIndex="5" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="-1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#080808" Opacity="0.95"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#080808" Opacity="0.95"/>
                            </Border.Background>
                        </Border>
                        <Border>
                            <Grid HorizontalAlignment="Center" Margin="10" Name="DMABigImagePanel" VerticalAlignment="Center" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.15*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.15*"/>
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource DmmFont}" Click="DMAImageLeft_Click" Name="DMABigImageLeft" Content="&lt;" Height="50" Width="50" FontWeight="SemiBold" FontSize="18"/>
                                <Image Grid.Column="1" Name="DMABigScreenshot" Stretch="Uniform" Margin="20,0,20,0" VerticalAlignment="Center"/>
                                <Image Grid.Column="1" gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/load.gif" Panel.ZIndex="-1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="90"/>
                                <Button Grid.Column="2" HorizontalAlignment="Left" FontFamily="{StaticResource DmmFont}" VerticalAlignment="Center" Click="DMAImageRight_Click" Name="DMABigImageRight" Content=">" Height="50" Width="50" FontWeight="SemiBold" FontSize="20"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.ColumnSpan="2" Margin="20" Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="DMACloseMedia_Click" FontFamily="{StaticResource DmmFont}" Content="Close" Height="50" Width="200" FontSize="18" FontWeight="SemiBold" Foreground="#f2f2f2">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="2"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.ColumnSpan="4" Grid.RowSpan="3" Name="DMADescPanel" Panel.ZIndex="4" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="-1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#080808" Opacity="0.95"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#080808" Opacity="0.95"/>
                            </Border.Background>
                        </Border>
                        <Border Grid.ColumnSpan="2" BorderThickness="0">
                            <TextBlock Grid.ColumnSpan="2" FontFamily="{StaticResource DmmFont}" VerticalAlignment="Center" Text="{Binding Path=Name}" TextTrimming="WordEllipsis" Foreground="#f2f2f2" FontWeight="SemiBold" FontSize="40" Padding="6,3,3,3"/>
                        </Border>
                        <Grid Name="DMAImagePanel" Visibility="Collapsed" VerticalAlignment="Center" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.15*"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="0.15*"/>
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="DMAImageLeft_Click" Name="DMAImageLeft" FontFamily="{StaticResource DmmFont}" Content="&lt;" Height="50" Width="50" FontWeight="SemiBold" FontSize="20"/>
                            <Image Grid.Column="1" Cursor="Hand" PreviewMouseLeftButtonDown="DMAImage_Click" Name="DMAScreenshot" Stretch="Uniform" MaxHeight="400" Margin="20,0,20,0" VerticalAlignment="Center"/>
                            <Image Grid.Column="1" gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/load.gif" Panel.ZIndex="-1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="90"/>
                            <Button Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Click="DMAImageRight_Click" Name="DMAImageRight" FontFamily="{StaticResource DmmFont}" Content=">" Height="50" Width="50" FontWeight="SemiBold" FontSize="20"/>
                        </Grid>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#404040"/>
                        <RichTextBox Margin="5" Name="DMADescText" Grid.Row="2" FontFamily="{StaticResource DmmFont}" Background="Transparent" BorderThickness="0" IsDocumentEnabled="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Foreground="#f2f2f2" Padding="10,0,10,10" FontSize="18"/>
                        <StackPanel Grid.ColumnSpan="2" Margin="20" Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Name="DMADownloadButton" Margin="0,0,20,0" Height="50" Width="200" CornerRadius="2" Background="#006ac1">
                                <Button Margin="3" Click="DMADownload_Click" Content="Download" FontFamily="{StaticResource DmmFont}" FontSize="25" FontWeight="SemiBold" Foreground="#f2f2f2">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="2"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Border>
                            <Button Name="DMAHomepageButton" FontFamily="{StaticResource DmmFont}" Click="DMAHomepage_Click" Margin="0,0,20,0" Height="50" Width="200" FontSize="25" FontWeight="SemiBold" Foreground="#f2f2f2">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="2"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Click="DMACloseDesc_Click" FontFamily="{StaticResource DmmFont}" Content="Close" Height="50" Width="200" FontSize="25" FontWeight="SemiBold" Foreground="#f2f2f2">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="2"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Name="DMALoadPanel" Grid.ColumnSpan="4" Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                        <Image Name="DMALoadingBar" gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/load.gif" VerticalAlignment="Center" HorizontalAlignment="Center" Height="150"/>
                    </StackPanel>
                    <StackPanel Name="DMAErrorPanel" Grid.ColumnSpan="4" Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" >
                        <TextBlock Name="DMABrowserMessage" HorizontalAlignment="Center" FontFamily="{StaticResource DmmFont}" Background="Transparent" Foreground="#f2f2f2" TextWrapping="Wrap" Width="800" TextAlignment="Center" FontSize="25"/>
                        <Button Margin="10" Click="DMABrowserRefreshButton_Click" Name="DMABrowserRefreshButton" Content="Retry" HorizontalAlignment="center" FontFamily="{StaticResource DmmFont}" FontSize="18"  Height="40" Width="140" Background="#181818" BorderBrush="#252525" Foreground="#f2f2f2">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <Border Grid.ColumnSpan="4" Grid.Row="1" CornerRadius="5" Margin="10,0,10,0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="Black" Opacity="0.75"/>
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="Black" Opacity="0.75"/>
                        </Border.Background>
                        <ListView Margin="5" Panel.ZIndex="1" Style="{StaticResource ListviewStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1"
                                  VerticalContentAlignment="Top" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                  Background="Transparent" BorderBrush="Transparent" Name="DMAFeedBox" ItemTemplate="{StaticResource DMAModTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="false"/>
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid SizeChanged="UniformGrid_SizeChanged"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
            <!--
            <TabItem Name="SongTab" Selector.Selected="SongTab_TabSelected" Selector.Unselected="SongTab_TabUnselected" FontSize="18" HorizontalAlignment="Center" Header="Song" Height="30" VerticalAlignment="Bottom" Visibility="Collapsed">
                <song:SongTab/>
            </TabItem>
            -->
            <TabItem Name="ModuleTab" Selector.Selected="ModuleTab_TabSelected" Selector.Unselected="ModuleTab_TabUnselected" FontSize="18" HorizontalAlignment="Center" Header="Module" Height="30" VerticalAlignment="Bottom" Visibility="Visible">
                <module:ModuleTab/>
            </TabItem>
            <TabItem Name="OptionTab" Selector.Selected="OptionTab_TabSelected" FontSize="18" HorizontalAlignment="Center" Header="Option">
                <TabItem.Content>
                    <Grid Name="OptionGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="OneClickInstallButton" Content="One-Click Install" Grid.Column="0" Grid.Row="0" Foreground="#f2f2f2" FontSize="18" FontWeight="Normal" Margin="10,10,10,10" Height="35" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="#181818" BorderBrush="#252525" FontFamily="{StaticResource DmmFont}" Click="OneClickInstallButton_Click"/>
                        <Button Name="SettingsBackUpButton" Content="Settings BackUp" Grid.Column="0" Grid.Row="1" Foreground="#f2f2f2" FontSize="18" FontWeight="Normal" Margin="10,0,10,0" Height="35" VerticalAlignment="Center" Background="#181818" BorderBrush="#252525" FontFamily="{StaticResource DmmFont}" Click="SettingsBackUpButton_Click"/>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem Name="DebugTabItem" Selector.Selected="DebugTab_TabSelected" FontSize="18" HorizontalAlignment="Center" Header="Debug" Height="30" VerticalAlignment="Bottom" Visibility="Hidden">
                <dev:DebugTab/>
            </TabItem>
        </TabControl>
    </Grid>

</Window>

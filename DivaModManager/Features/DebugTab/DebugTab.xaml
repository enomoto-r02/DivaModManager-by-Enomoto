<UserControl x:Class="DivaModManager.Features.Debug.DebugTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid VerticalAlignment="Top" Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Grid.Column="0">
            <Button Foreground="#f2f2f2" FontFamily="{StaticResource DmmeFont}" FontWeight="Normal" Height="30" Background="#303030" BorderBrush="#353535" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="30,5,30,5" Content="Do Hang" Click="Hang_Click" Cursor=""/>
            <Button Foreground="#f2f2f2" FontFamily="{StaticResource DmmeFont}" FontWeight="Normal" Height="30" Background="#303030" BorderBrush="#353535" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="30,5,30,5" Content="Do Window Out" Click="WindowOut_Click"/>
            <Button Foreground="#f2f2f2" FontFamily="{StaticResource DmmeFont}" FontWeight="Normal" Height="30" Background="#303030" BorderBrush="#353535" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="30,5,30,5" Content="Setting Files Open" Click="SettingFilesOpen_Click"/>
        </StackPanel>
        <StackPanel x:Name="DeveloperStackPanel" Orientation="Vertical" Grid.Column="1" Visibility="Hidden">
            <Button x:Name="GlobalModListDumpButton" Grid.Column="0" Foreground="#f2f2f2" FontFamily="{StaticResource DmmeFont}" FontWeight="Normal" Height="30" Background="#303030" BorderBrush="#353535" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="30,5,30,5" Content="Global_ModList_Dump_Click" Click="Global_ModList_Dump_Click"/>
        </StackPanel>
    </Grid>
</UserControl>

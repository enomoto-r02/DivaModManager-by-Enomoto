<UserControl 
    x:Class="DivaModManager.Features.Song.SongTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fa5="http://schemas.fontawesome.com/icons/"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    Background="#131313"
    mc:Ignorable="d"
>
    <Grid x:Name="GridItem">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition MinHeight="200"/>
        </Grid.RowDefinitions>
        <ComboBox Grid.Column="0" Margin="5" FontFamily="{StaticResource DmmFont}" Name="ModFilterComboBox" DropDownClosed="ModFilterComboBox_DropDownClosed">
            <ComboBoxItem Content="Mod Filter" IsSelected="True"/>
            <ComboBoxItem Content="BASE"/>
            <ComboBoxItem Content="Mod"/>
        </ComboBox>
        <ComboBox Grid.Column="1" Margin="5" FontFamily="{StaticResource DmmFont}" Name="TypeFilterComboBox" DropDownClosed="TypeFilterComboBox_DropDownClosed">
            <ComboBoxItem Content="Type Filter" IsSelected="True"/>
            <ComboBoxItem Content="Song"/>
            <ComboBoxItem Content="Another Song"/>
        </ComboBox>
        <ComboBox Grid.Column="2" Margin="5" FontFamily="{StaticResource DmmFont}" Name="KeyFilterComboBox" DropDownClosed="KeyFilterComboBox_DropDownClosed">
            <ComboBoxItem Content="Key Filter" IsSelected="True"/>
            <ComboBoxItem Content="xxx.xxx.another_song"/>
            <ComboBoxItem Content="xxx.xxx.arranger"/>
            <ComboBoxItem Content="xxx.xxx.chara"/>
            <ComboBoxItem Content="xxx.xxx.extra"/>
            <ComboBoxItem Content="xxx.xxx.illustrator"/>
            <ComboBoxItem Content="xxx.xxx.level"/>
            <ComboBoxItem Content="xxx.xxx.lyrics"/>
            <ComboBoxItem Content="xxx.xxx.movie_file_name"/>
            <ComboBoxItem Content="xxx.xxx.music"/>
            <ComboBoxItem Content="xxx.xxx.script_file_name"/>
            <ComboBoxItem Content="xxx.xxx.song_name"/>
            <ComboBoxItem Content="xxx.xxx.song_name_en"/>
            <ComboBoxItem Content="xxx.xxx.song_name_en2"/>
            <ComboBoxItem Content="xxx.xxx.song_name_reading"/>
            <ComboBoxItem Content="xxx.xxx.song_name_reading_en"/>
            <ComboBoxItem Content="xxx.xxx.song_name_ro"/>
            <ComboBoxItem Content="xxx.xxx.type"/>
            <ComboBoxItem Content="xxx.xxx.vocal_disp_name"/>
            <ComboBoxItem Content="xxx.xxx.vocal_disp_name_en"/>
        </ComboBox>
        <ComboBox Grid.Column="3" Margin="5" FontFamily="{StaticResource DmmFont}" Name="ConflictFilterComboBox" DropDownClosed="ConflictFilterComboBox_DropDownClosed" Visibility="Collapsed">
            <ComboBoxItem Content="Conflict Filter" IsSelected="True"/>
            <ComboBoxItem Content="ON"/>
        </ComboBox>
        <DataGrid
            Grid.Row="1"
            Grid.ColumnSpan="6"
            Name="SongGrid"
            AlternatingRowBackground="#2A2A2A"
            AutoGenerateColumns="False"
            Background="#202020"
            BorderBrush="#424242"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            FontSize="15"
            Foreground="#f2f2f2"
            GridLinesVisibility="Vertical"
            HeadersVisibility="Column"
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Auto"
            IsTextSearchEnabled="True"
            IsReadOnly="True"
            Margin="5"
            RowBackground="#202020"
            SelectionMode="Extended"
            VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingStackPanel.IsVirtualizing="True"
        >
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="1,0,1,0"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#115F58"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#f2f2f2"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#115F58" />
                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#303030" />
                    <Setter Property="Foreground" Value="#f2f2f2"/>
                    <Setter Property="Height" Value="17"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.FontFamily>
                <StaticResource ResourceKey="DmmFont"/>
            </DataGrid.FontFamily>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#303030" />
                    <Setter Property="Foreground" Value="#f2f2f2"/>
                    <Setter Property="Height" Value="17"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <EventSetter Event="ButtonBase.Click" Handler="SongGridHeader_Click"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mod Name" Binding="{Binding ModName}" MinWidth="30" Width="320" />
                <DataGridTextColumn Header="Another Song" Binding="{Binding TypeValue}" MinWidth="30" Width="90" />
                <DataGridTextColumn Header="Song ID" Binding="{Binding SongID}" MinWidth="30" Width="60" />
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" MinWidth="30" Width="300" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" MinWidth="30" Width="450" />
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" MinWidth="30" Width="60" />
                <DataGridTextColumn Header="Song File Path" Binding="{Binding SongFilePath}" MinWidth="30" Width="360" />
            </DataGrid.Columns>
        </DataGrid>
        <!--
        <Image Name="LoadingBar" gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/load.gif"
               Panel.ZIndex="10" VerticalAlignment="Center" HorizontalAlignment="Center" Height="150"
               Visibility="Collapsed"/>
        -->
    </Grid>
</UserControl>

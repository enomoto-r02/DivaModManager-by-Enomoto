<UserControl 
    x:Class="DivaModManager.Features.Module.ModuleTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fa5="http://schemas.fontawesome.com/icons/"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    Background="#131313"
    mc:Ignorable="d"
    d:DesignHeight="400" d:DesignWidth="600"
>
    <Grid>
        <DataGrid
            Name="ModuleGrid"
            AlternatingRowBackground="#2A2A2A"
            AutoGenerateColumns="False"
            Background="#202020"
            BorderBrush="#424242"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            FontSize="15"
            Foreground="#f2f2f2"
            GridLinesVisibility="Vertical"
            HeadersVisibility="Column"
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Auto"
            IsTextSearchEnabled="True"
            IsReadOnly="True"
            Margin="5"
            RowBackground="#202020"
            SelectionMode="Extended"
            VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.VirtualizationMode="Standard"
            VirtualizingStackPanel.IsVirtualizing="True"
        >
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="1,0,1,0"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#115F58"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#f2f2f2"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#115F58" />
                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#303030" />
                    <Setter Property="Foreground" Value="#f2f2f2"/>
                    <Setter Property="Height" Value="17"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.FontFamily>
                <StaticResource ResourceKey="DmmFont"/>
            </DataGrid.FontFamily>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#303030" />
                    <Setter Property="Foreground" Value="#f2f2f2"/>
                    <Setter Property="Height" Value="17"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <EventSetter Event="ButtonBase.Click" Handler="ModuleGridHeader_Click"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mod Name" Binding="{Binding ModName}" Width="Auto" />
                <DataGridTextColumn Header="Module File Path" Binding="{Binding ModuleFilePath}" Width="Auto" />
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="Auto" />
                <DataGridTextColumn Header="Item No" Binding="{Binding ItemNo}" Width="Auto" />
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="Auto" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<UserControl 
    x:Class="DivaModManager.Features.Module.ModuleTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fa5="http://schemas.fontawesome.com/icons/"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    Background="#131313"
    mc:Ignorable="d"
>
    <Grid x:Name="GridItem">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
            <ColumnDefinition MinWidth="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition MinHeight="200"/>
        </Grid.RowDefinitions>
        <ComboBox Grid.Column="0" Margin="5" FontFamily="{StaticResource DmmFont}" Name="ModFilterComboBox" DropDownClosed="ModFilterComboBox_DropDownClosed">
            <ComboBoxItem Content="Mod Filter" />
            <ComboBoxItem Content="BASE"/>
            <ComboBoxItem Content="Mod" IsSelected="True"/>
        </ComboBox>
        <ComboBox Grid.Column="1" Margin="5" FontFamily="{StaticResource DmmFont}" Name="TypeFilterComboBox" DropDownClosed="TypeFilterComboBox_DropDownClosed">
            <ComboBoxItem Content="Type Filter"/>
            <ComboBoxItem Content="module" IsSelected="True"/>
            <ComboBoxItem Content="custumize"/>
        </ComboBox>
        <ComboBox Grid.Column="2" Margin="5" FontFamily="{StaticResource DmmFont}" Name="KeyFilterComboBox" DropDownClosed="KeyFilterComboBox_DropDownClosed">
            <ComboBoxItem Content="Key Filter"/>
            <ComboBoxItem Content="xxx.xxx.attr"/>
            <ComboBoxItem Content="xxx.xxx.chara"/>
            <ComboBoxItem Content="xxx.xxx.cos" IsSelected="True"/>
            <ComboBoxItem Content="xxx.xxx.id"/>
            <ComboBoxItem Content="xxx.xxx.name"/>
            <ComboBoxItem Content="xxx.xxx.sort_index"/>
        </ComboBox>
        <ComboBox Grid.Column="3" Margin="5" FontFamily="{StaticResource DmmFont}" Name="ConflictFilterComboBox" DropDownClosed="ConflictFilterComboBox_DropDownClosed" Visibility="Collapsed">
            <ComboBoxItem Content="Conflict Filter" IsSelected="True"/>
            <ComboBoxItem Content="ON"/>
        </ComboBox>
        <DataGrid
            Grid.Row="1"
            Grid.ColumnSpan="6"
            Name="ModuleGrid"
            AlternatingRowBackground="#2A2A2A"
            AutoGenerateColumns="False"
            Background="#202020"
            BorderBrush="#424242"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            FontSize="15"
            Foreground="#f2f2f2"
            GridLinesVisibility="Vertical"
            HeadersVisibility="Column"
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Auto"
            IsTextSearchEnabled="True"
            IsReadOnly="True"
            Margin="5"
            RowBackground="#202020"
            SelectionMode="Extended"
            VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingStackPanel.IsVirtualizing="True">
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="1,0,1,0"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#115F58"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#f2f2f2"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#115F58" />
                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#303030" />
                    <Setter Property="Foreground" Value="#f2f2f2"/>
                    <Setter Property="Height" Value="17"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.FontFamily>
                <StaticResource ResourceKey="DmmFont"/>
            </DataGrid.FontFamily>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#303030" />
                    <Setter Property="Foreground" Value="#f2f2f2"/>
                    <Setter Property="Height" Value="17"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <EventSetter Event="ButtonBase.Click" Handler="ModuleGridHeader_Click"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mod Name" Binding="{Binding ModName}" MinWidth="30" Width="320" />
                <!-- <DataGridTextColumn Header="Module File Path" Binding="{Binding ModuleFilePath}" MinWidth="30" Width="360" /> -->
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" MinWidth="30" Width="60" />
                <DataGridTextColumn Header="Cos ID" Binding="{Binding CosID}" MinWidth="30" Width="60" />
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" MinWidth="30" Width="180" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" MinWidth="30" Width="300" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

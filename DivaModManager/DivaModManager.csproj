<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>DivaModManager</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\miku.ico</ApplicationIcon>
    <AssemblyName>DivaModManager</AssemblyName>
    <AssemblyVersion>1.3.1.35</AssemblyVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>AnyCPU;x64</Platforms>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\caution.png" />
    <None Remove="Assets\discord.png" />
    <None Remove="Assets\DMA_BLACK.png" />
    <None Remove="Assets\dml.png" />
    <None Remove="Assets\dml_backup.png" />
    <None Remove="Assets\dummy.png" />
    <None Remove="Assets\fontawesome\circle-info.png" />
    <None Remove="Assets\fontawesome\discord.png" />
    <None Remove="Assets\fontawesome\search.png" />
    <None Remove="Assets\fontawesome\times-circle.png" />
    <None Remove="Assets\load.gif" />
    <None Remove="Assets\load.webp" />
    <None Remove="Assets\noimage.png" />
    <None Remove="Assets\preview.png" />
    <None Remove="Assets\preview_enomoto.png" />
    <None Remove="Assets\github-mark-white.png" />
    <None Remove="Downloads\Do not place files under this folder" />
    <None Remove="GameBanana.png" />
    <None Remove="License.txt" />
    <None Remove="x64\7z.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AnekLatin-Medium.ttf" />
    <Resource Include="Assets\AnekLatin-Regular.ttf" />
    <Resource Include="Assets\AnekLatin-SemiBold.ttf" />
    <Resource Include="Assets\fontawesome\discord.png" />
    <Resource Include="Assets\fontawesome\times-circle.png" />
    <Resource Include="Assets\miku.ico">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\fontawesome\circle-info.png" />
    <Resource Include="Assets\fontawesome\search.png" />
    <Content Include="Downloads\Do not place files under this folder">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="License.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\Apache-2.0 license.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\BSD 2-Clause license.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\BSD 3-Clause license.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\GNU LGPL License (7-Zip).txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\GPL-3.0 license (DivaModManager).txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\Licenses Info.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\MIT License.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="x64\7z.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\dummy.png" />
    <EmbeddedResource Include="Resources\Message.toml">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />
    <PackageReference Include="FontAwesome5" Version="2.1.11" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\caution.png" />
    <Resource Include="Assets\DMA_BLACK.png" />
    <Resource Include="Assets\dml.png" />
    <Resource Include="Assets\GameBanana.png" />
    <Resource Include="Assets\mmplus.png">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\load.gif">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\noimage.png">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\preview.png" />
    <Resource Include="Assets\preview_enomoto.png" />
    <Resource Include="Assets\github-mark-white.png" />
    <Resource Include="Assets\gift-solid.png" />
    <Resource Include="Common\Style\Button.xaml" />
    <Resource Include="Common\Style\ComboBox.xaml" />
    <Resource Include="Common\Style\ScrollViewer.xaml" />
    <Content Include="x64\7z.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Misk\FetchMetadataWindow.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Misk\CreateModWindow.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Misk\ConfigureModWindow.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Misk\FetchMetadataWindow.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Features\AltLink\AltLinkWindow.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Common\Style\Button.xaml" />
    <Page Remove="Common\Style\ComboBox.xaml" />
    <Page Remove="Common\Style\ScrollViewer.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="BASE\diva_dlc00\Place the data extracted from the game here">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="BASE\diva_dlc00_region\Place the data extracted from the game here">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="BASE\diva_main\Place the data extracted from the game here">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="BASE\diva_main_region\Place the data extracted from the game here">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ErrorReportTemplate\ErrorReportTemplate Example%28EN%29.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ErrorReportTemplate\ErrorReportTemplate(EN).txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="readme_en.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="readme_jp.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ErrorReportTemplate\エラー報告用テンプレート 記入例(JP).txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ErrorReportTemplate\エラー報告用テンプレート(JP).txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

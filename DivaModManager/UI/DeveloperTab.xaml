<UserControl x:Class="DivaModManager.UI.DeveloperTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
>
    <Grid VerticalAlignment="Center" x:Name="GridItem" Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Grid.Column="0" Grid.Row="0" Foreground="#f2f2f2" FontFamily="{StaticResource AnekLatin}" FontWeight="Medium" Height="30" Background="#303030" BorderBrush="#353535" VerticalAlignment="Bottom" Content="Hang" Click="Hang_Click"/>
        <Button Grid.Column="0" Grid.Row="1" Foreground="#f2f2f2" FontFamily="{StaticResource AnekLatin}" FontWeight="Medium" Height="30" Background="#303030" BorderBrush="#353535" VerticalAlignment="Bottom" Content="Window Out" Click="WindowOut_Click"/>
        <Button Grid.Column="0" Grid.Row="2" Foreground="#f2f2f2" FontFamily="{StaticResource AnekLatin}" FontWeight="Medium" Height="30" Background="#303030" BorderBrush="#353535" VerticalAlignment="Bottom" Content="Cmd Get" Click="CmdGet_Click"/>
    </Grid>
</UserControl>
